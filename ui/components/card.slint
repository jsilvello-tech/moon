import { Theme } from "../themes/palette.slint";

export component MoonCard {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <color> accent_color: Theme.crystal_cyan;

    Rectangle {
        background: Theme.card_bg;
        border-radius: Theme.radius_md;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            if root.title != "": HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.title;
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        font-size: 11px;
                        color: Theme.text_secondary;
                    }
                }

                // Accent top-right dot
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.accent_color;
                }
            }

            @children
        }
    }
}
